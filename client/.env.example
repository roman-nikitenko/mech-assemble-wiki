# API base URL. Leave EMPTY in dev so requests go same-origin through the
# Vite proxy (see vite.config.ts) — this keeps the session cookie working.
# Set to the API's origin only if you run the client against a remote API.
VITE_API_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXX). Leave EMPTY to disable
# tracking (local dev). When set, the app loads gtag.js and reports pageviews.
VITE_GA_MEASUREMENT_ID=
