# Copy to .env and adjust for your local Postgres.
# Postgres.app on macOS: user = your macOS username, no password.
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/mech_assemble_wiki?schema=public"

# Social login (OAuth) — reuse the Google/Discord apps from the old Auth0 setup.
# See docs/auth-social-login.md for the provider-dashboard steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the httpOnly session cookie (generate: openssl rand -hex 32)
SESSION_JWT_SECRET=
# Public base URL used to build OAuth redirect URIs and post-login redirects.
# Prod: https://mech-assemble-wiki.online   Dev: http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Admin login (separate from player social login — single env credential).
ADMIN_LOGIN=admin
# generate with: npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH=salt:hash
ADMIN_JWT_SECRET=any-long-random-string

# Set to "production" on the VPS so the session cookie is marked Secure.
NODE_ENV=development

# Production only. Locks CORS to the live site's origin. Leave UNSET locally
# so the Vite dev server (:5173) can still call the API.
# CLIENT_ORIGIN=https://mech-assemble-wiki.online
# Optional: the port the API listens on (defaults to 3000).
# PORT=3000
